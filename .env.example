# ключ с openrouter.ai/keys, без него генерация не работает
# вместо .env ключ можно ввести на странице «Ключ» в панели, он ляжет в хранилище Windows
OPENROUTER_API_KEY=
# или путь к файлу, в котором лежит только ключ
# OPENROUTER_API_KEY_FILE=
# брать ли ключ из хранилища учётных данных системы
# USE_KEYRING=true

# дополнительные модели к готовому списку в панели, через запятую
OPENROUTER_MODELS=
DEFAULT_MODEL=openai/gpt-4o-mini
# модель для фото команды
DEFAULT_IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# лимит трат на одну операцию по умолчанию, доллары
MAX_COST_USD=0.10
# больше этого лимит из панели не принимается
MAX_COST_CAP_USD=5.0
MAX_RETRIES=2
# сколько секунд ждать ответа OpenRouter
# REQUEST_TIMEOUT=120

# где лежат база, собранные сайты и фото
# DATABASE_URL=sqlite:///data/app.db
# SITES_DIR=data/sites
# MEDIA_DIR=data/media

# документация API на /docs, журнал в JSON, адреса, с которых пускаем
# DOCS=true
# LOG_JSON=false
# ALLOWED_HOSTS=localhost,127.0.0.1
